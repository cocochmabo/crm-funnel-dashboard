# Скопируйте файл в .env и заполните значениями своего портала.
# Реальный .env в репозиторий не добавляется: он в .gitignore.

# Ключ приложения для доступа к порталу (заголовок X-Api-Key).
# Нужны права: crm (чтение) и user (чтение).
BITRIX_API_KEY=

# Базовый адрес REST-прокси портала, например https://vibecode.bitrix24.tech/v1
BITRIX_API_BASE_URL=

# Домен портала без схемы, например portal.bitrix24.ru — для ссылок на карточки сделок
BITRIX_PORTAL_DOMAIN=

# Необязательные параметры
# PORT=3000
# PORTAL_TIMEOUT_MS=180000
